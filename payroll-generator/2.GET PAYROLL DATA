function pickPetrolAsOf_(petrolIndex, idno, monthStart, valueHeader) {
  const list = petrolIndex.byId.get(idno);
  if (!list || !list.length) return '';

  const t = monthStart.getTime();
  let best = null;
  for (const item of list) {
    if (item.effDate.getTime() <= t) best = item;
    else break;
  }
  return best ? best.get(valueHeader) : '';
}

/* ===========================
   Helpers — Idempotent writes
=========================== */

function clearScriptColumns_(payrollSheet, payrollHeaders, nonScriptSet, rowCount) {
  const hdrIdx = buildHeaderIndex_(payrollHeaders);

  Object.keys(CONST.MAP || {}).forEach((payCol) => {
    const k = norm_(payCol);
    if (!hdrIdx.has(k)) return;
    if (nonScriptSet.has(k)) return;

    const spec = CONST.MAP[payCol];
    if (spec.sheet === 'DATA_VALIDATION') return;
    if (spec.sheet === 'MANUAL_OR_RULE') return;

    const col = hdrIdx.get(k) + 1;
    payrollSheet.getRange(2, col, rowCount, 1).clearContent();
  });

  const keyCol = hdrIdx.get(norm_(CONST.KEYS.PAYROLL)) + 1;
  payrollSheet.getRange(2, keyCol, rowCount, 1).clearContent();
}

function ensureRowCapacity_(sheet, neededRows) {
  const max = sheet.getMaxRows();
  if (max < neededRows) sheet.insertRowsAfter(max, neededRows - max);
}

