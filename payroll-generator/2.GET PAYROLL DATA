function defaultNumericIfNeeded_(payHeader, currentVal) {
  const k = norm_(payHeader);
  const numericHeaders = new Set([
    norm_('Basic'),
    norm_('DA'),
    norm_('HRA'),
    norm_('Conveyance Allowance'),
    norm_('Special Allowance'),
    norm_('Increment'),
    norm_('Petrol Conveyance'),
    norm_('Other Payments [Gross]'),
    norm_('Other Payments [Net]'),
    norm_('Other Deductions'),
    norm_('Advance Deduction'),
  ]);
  if (!numericHeaders.has(k)) return currentVal;
  if (currentVal === '' || currentVal === null || currentVal === undefined) return 0;
  return currentVal;
}

/* ===========================
   Helpers — Numbers & Dates
=========================== */

function toNumber_(v) {
  const s = String(v || '').replace(/[,₹% ]/g, '').trim();
  if (!s) return 0;
  const n = Number(s);
  return isNaN(n) ? 0 : n;
}

function normalizeNumberIfPossible_(v) {
  if (v === null || v === undefined) return '';
  const s = String(v).trim();
  if (s === '') return '';

  const n = toNumber_(s);
  if (n === 0 && s !== '0' && s !== '0.0' && s !== '0.00') return v;
  return n;
}

function tryParseDate_(v) {
  if (v instanceof Date && !isNaN(v)) return v;

  const raw = String(v || '').trim();
  if (!raw) return null;

  const s = raw.replace(/[-]+/g, ' ').replace(/_+/g, ' ').replace(/\s+/g, ' ').trim();
  const m = s.match(/^([A-Za-z]+)\s+(\d{4})$/);
  if (m) {
    const monthIndex = monthNameToIndex_(m[1]);
    const year = parseInt(m[2], 10);
    if (monthIndex !== null && !isNaN(year)) return new Date(year, monthIndex, 1);
  }

  const d = new Date(raw);
  return isNaN(d) ? null : d;
}
