/* =========================================================
   CORE SERVER FUNCTION — EMPLOYEES / EMPLOYEES_HINDI
   (runs as owner always)
========================================================= */

function generatePayslipsServer_(payload) {
  const spreadsheetId = String(payload.spreadsheetId || '').trim();

  const lock = LockService.getScriptLock();
  try {
    lock.waitLock(30000);
  } catch (e) {
    return { success: false, message: 'Another payslip generation is already running. Please wait and try again.' };
  }

  let createdNewPayslipFile = false;
  let anyDataWrittenThisRun = false;
  let payslipFileForCleanup = null;

  try {
    if (!PSG.TEMPLATE_FILE_ID || PSG.TEMPLATE_FILE_ID === 'PASTE_TEMPLATE_PAYSLIP_FILE_ID_HERE') {
      return { success: false, message: 'PSG.TEMPLATE_FILE_ID is not configured. Paste the Template Payslip file ID before running.' };
    }

    const ss = SpreadsheetApp.openById(spreadsheetId);

    const payrollSh = ss.getSheetByName(CONST.TEMPLATES.PAYROLL_TAB_NAME);
    if (!payrollSh) throw new Error(`Missing sheet: ${CONST.TEMPLATES.PAYROLL_TAB_NAME}`);

    const metaSh = ss.getSheetByName(CONST.TABS.META_DATA);
    if (!metaSh) throw new Error(`Missing sheet: ${CONST.TABS.META_DATA}`);

    const lockStatus = String(psgGetMetaValue_(metaSh, 'LOCK_STATUS') || '').trim().toUpperCase();
    if (lockStatus !== CONST.VALUES.LOCK_STATUS_LOCKED) {
      return { success: false, message: 'Payroll is not LOCKED. Payslips can only be generated after LOCK_STATUS = LOCKED.' };
    }

    const monthLabel = String(psgGetMetaValue_(metaSh, 'PAYROLL_MONTH_LABEL') || '').trim();
    if (!monthLabel) return { success: false, message: 'PAYROLL_MONTH_LABEL is missing in META_DATA.' };

    const lastRow = payrollSh.getLastRow();
    const lastCol = payrollSh.getLastColumn();
    if (lastRow < 2 || lastCol < 1) return { success: false, message: 'No payroll data found in PAY_ROLL.' };

    const headers = payrollSh.getRange(1, 1, 1, lastCol).getDisplayValues()[0];
    const idx = psgBuildHeaderIndex_(headers);

    psgRequireHeader_(idx, 'Employee Code', 'PAY_ROLL');
    psgRequireHeader_(idx, 'Category', 'PAY_ROLL');
    psgRequireHeader_(idx, 'Bank Transfer Mark Down', 'PAY_ROLL');

    const data = payrollSh.getRange(2, 1, lastRow - 1, lastCol).getDisplayValues();

    const eligible = [];
    for (let i = 0; i < data.length; i++) {
      const row = data[i];
      const empCode = String(psgGetCell_(row, idx, 'Employee Code') || '').trim();
      if (!empCode) continue;

      const markDown = String(psgGetCell_(row, idx, 'Bank Transfer Mark Down') || '').trim();
      if (!psgIsRealTimestamp_(markDown)) continue;

      eligible.push({ row, empCode });
    }

    if (!eligible.length) {
      return { success: false, message: 'No eligible employees found (no PAY_ROLL row has a Bank Transfer Mark Down timestamp yet).' };
    }

    // ---- Get/create this month's subfolder (v9) ----
    const monthlyFolder = psgGetOrCreateMonthlyFolder_(metaSh, monthLabel);

    let existingFileId = psgExtractSpreadsheetId_(psgGetMetaValue_(metaSh, PSG.META_KEYS.PAYSLIP_FILE_ID));
    let payslipSs;
    let payslipFile;

    if (existingFileId) {
      payslipSs = SpreadsheetApp.openById(existingFileId);
      payslipFile = DriveApp.getFileById(existingFileId);

      // v9 self-heal: if this file was created before the monthly-subfolder
      // change (sitting directly in MONTHLY PAYSLIPS), move it in now.
      psgEnsureFileInFolder_(payslipFile, monthlyFolder);
    } else {
      const templateFile = DriveApp.getFileById(PSG.TEMPLATE_FILE_ID);
      const fileName = `${PSG.FILE_PREFIX}_${monthLabel}`;

      payslipFile = templateFile.makeCopy(fileName, monthlyFolder);
      payslipSs = SpreadsheetApp.openById(payslipFile.getId());

      existingFileId = payslipFile.getId();
      createdNewPayslipFile = true;
      payslipFileForCleanup = payslipFile;

      psgSetMetaHyperlink_(metaSh, PSG.META_KEYS.PAYSLIP_FILE_ID, existingFileId);
    }

    psgApplyFilePermissions_(payslipFile);

    const empSh = payslipSs.getSheetByName(PSG.TABS.EMPLOYEES);
    const empHiSh = payslipSs.getSheetByName(PSG.TABS.EMPLOYEES_HINDI);
    if (!empSh) throw new Error(`Template is missing tab: ${PSG.TABS.EMPLOYEES}`);
    if (!empHiSh) throw new Error(`Template is missing tab: ${PSG.TABS.EMPLOYEES_HINDI}`);
    // Staffs tab is intentionally NOT looked up / required here — Staff are
    // handled entirely by generateStaffPayslipPdfsServer_ (see below).

    const logSh = psgGetOrCreateLogSheet_(payslipSs);

    const processed = psgReadProcessed_(logSh, monthLabel);

    const migrantByCode = psgReadMigrantMap_();

    const newEmployees = [];
    const newEmployeesHi = [];

    eligible.forEach((item) => {
      if (processed.has(item.empCode)) return;

      const category = String(psgGetCell_(item.row, idx, 'Category') || '').trim().toUpperCase();

      // STAFF is intentionally skipped here — see generateStaffPayslipPdfsServer_.
      if (category === PSG.CATEGORY.STAFF) return;

      const migrant = String(migrantByCode.get(item.empCode) || '').trim().toUpperCase();
      if (migrant === PSG.MIGRANT.MIGRANT) {
        newEmployeesHi.push(item);
      } else {
        newEmployees.push(item);
      }
    });

    if (!newEmployees.length && !newEmployeesHi.length) {
      return { success: true, message: 'No new eligible employees to add — payslips already generated for everyone eligible so far this month.' };
    }

    if (newEmployees.length) {
      const already = psgCountForTab_(logSh, monthLabel, PSG.TABS.EMPLOYEES);
      psgWriteWorkerTab_Landscape_(empSh, newEmployees, idx, monthLabel, already);
      anyDataWrittenThisRun = true;
      psgAppendToLog_(logSh, monthLabel, newEmployees.map((x) => x.empCode), PSG.TABS.EMPLOYEES);
    }

    if (newEmployeesHi.length) {
      const already = psgCountForTab_(logSh, monthLabel, PSG.TABS.EMPLOYEES_HINDI);
      psgWriteWorkerTab_Landscape_(empHiSh, newEmployeesHi, idx, monthLabel, already);
      anyDataWrittenThisRun = true;
      psgAppendToLog_(logSh, monthLabel, newEmployeesHi.map((x) => x.empCode), PSG.TABS.EMPLOYEES_HINDI);
    }

    psgSetMetaValue_(metaSh, PSG.META_KEYS.PAYSLIP_LAST_RUN,
      Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'yyyy-MM-dd HH:mm'));

    const successMsg =
      `Payslips generated for ${monthLabel}.\n\n` +
      `New Employees (Tamil): ${newEmployees.length}\n` +
      `New Employees (Hindi/Migrant): ${newEmployeesHi.length}\n\n` +
      `File: ${payslipFile.getName()}\n` +
      `Folder: ${monthlyFolder.getName()}`;

    return { success: true, message: successMsg };

  } catch (err) {
    if (createdNewPayslipFile && !anyDataWrittenThisRun && payslipFileForCleanup) {
      try { payslipFileForCleanup.setTrashed(true); } catch (_) {}
    }
    return { success: false, message: `Error: ${err && err.message ? err.message : err}` };
  } finally {
    try { lock.releaseLock(); } catch (_) {}
  }
}

/* =========================================================
   CORE SERVER FUNCTION — STAFF PDF GENERATION (NEW, v9)
   (runs as owner always)
========================================================= */

function generateStaffPayslipPdfsServer_(payload) {
  const spreadsheetId = String(payload.spreadsheetId || '').trim();

  const lock = LockService.getScriptLock();
  try {
    lock.waitLock(30000);
  } catch (e) {
    return { success: false, message: 'Another Staff payslip PDF generation is already running. Please wait and try again.' };
  }

  try {
    const ss = SpreadsheetApp.openById(spreadsheetId);

    const payrollSh = ss.getSheetByName(CONST.TEMPLATES.PAYROLL_TAB_NAME);
    if (!payrollSh) throw new Error(`Missing sheet: ${CONST.TEMPLATES.PAYROLL_TAB_NAME}`);

    const metaSh = ss.getSheetByName(CONST.TABS.META_DATA);
    if (!metaSh) throw new Error(`Missing sheet: ${CONST.TABS.META_DATA}`);

    const lockStatus = String(psgGetMetaValue_(metaSh, 'LOCK_STATUS') || '').trim().toUpperCase();
    if (lockStatus !== CONST.VALUES.LOCK_STATUS_LOCKED) {
      return { success: false, message: 'Payroll is not LOCKED. Staff payslip PDFs can only be generated after LOCK_STATUS = LOCKED.' };
    }

    const monthLabel = String(psgGetMetaValue_(metaSh, 'PAYROLL_MONTH_LABEL') || '').trim();
    if (!monthLabel) return { success: false, message: 'PAYROLL_MONTH_LABEL is missing in META_DATA.' };

    const existingFileId = psgExtractSpreadsheetId_(psgGetMetaValue_(metaSh, PSG.META_KEYS.PAYSLIP_FILE_ID));
    if (!existingFileId) {
      return { success: false, message: 'No Payslip file found for this month yet. Run "Generate Payslips" first.' };
    }

    const payslipSs = SpreadsheetApp.openById(existingFileId);
    const payslipFile = DriveApp.getFileById(existingFileId);

    const monthlyFolder = psgGetOrCreateMonthlyFolder_(metaSh, monthLabel);
    psgEnsureFileInFolder_(payslipFile, monthlyFolder);

    const staffSh = payslipSs.getSheetByName(PSG.TABS.STAFFS);
    if (!staffSh) throw new Error(`Payslip file is missing tab: ${PSG.TABS.STAFFS}`);

    const emailSh = payslipSs.getSheetByName(PSG.STAFF_PDF.TAB_NAME);
    if (!emailSh) throw new Error(`Payslip file is missing tab: ${PSG.STAFF_PDF.TAB_NAME}`);

    const emailData = psgLoadStaffEmailMaster_(emailSh);

    const lastRow = payrollSh.getLastRow();
    const lastCol = payrollSh.getLastColumn();
    if (lastRow < 2 || lastCol < 1) return { success: false, message: 'No payroll data found in PAY_ROLL.' };

    const headers = payrollSh.getRange(1, 1, 1, lastCol).getDisplayValues()[0];
    const idx = psgBuildHeaderIndex_(headers);

    psgRequireHeader_(idx, 'Employee Code', 'PAY_ROLL');
    psgRequireHeader_(idx, 'Category', 'PAY_ROLL');
    psgRequireHeader_(idx, 'Bank Transfer Mark Down', 'PAY_ROLL');

    const data = payrollSh.getRange(2, 1, lastRow - 1, lastCol).getDisplayValues();

    const eligibleStaff = [];
    for (let i = 0; i < data.length; i++) {
      const row = data[i];
      const empCode = String(psgGetCell_(row, idx, 'Employee Code') || '').trim();
      if (!empCode) continue;

      const category = String(psgGetCell_(row, idx, 'Category') || '').trim().toUpperCase();
      if (category !== PSG.CATEGORY.STAFF) continue;

      const markDown = String(psgGetCell_(row, idx, 'Bank Transfer Mark Down') || '').trim();
      if (!psgIsRealTimestamp_(markDown)) continue;

      eligibleStaff.push({ row, empCode });
    }

    if (!eligibleStaff.length) {
      return { success: false, message: 'No eligible Staff found (no PAY_ROLL row has a Bank Transfer Mark Down timestamp yet).' };
    }

    // ---- Skip anyone who already has a "PDF File ID" — the ONLY completion marker for Staff ----
    const pending = eligibleStaff.filter((item) => {
      const rec = emailData.map.get(item.empCode);
      return !(rec && rec.fileId);
    });

    if (!pending.length) {
      return { success: true, message: 'No new Staff payslip PDFs to generate — everyone eligible already has one this month.' };
    }

    const leaveByCode = psgReadLeaveBalances_();

    let alreadyGenerated = 0;
    emailData.map.forEach((rec) => { if (rec.fileId) alreadyGenerated++; });

    let generatedCount = 0;

    for (let i = 0; i < pending.length; i++) {
      const item = pending[i];
      const empCode = item.empCode;
      const name = psgProperCase_(psgGetCell_(item.row, idx, 'Name'));

      let rec = emailData.map.get(empCode);
      let sheetRow;
      if (!rec) {
        sheetRow = psgAppendStaffEmailRow_(emailSh, emailData, empCode, name);
        rec = { sheetRow, name, email: '', fileId: '' };
        emailData.map.set(empCode, rec);
      } else {
        sheetRow = rec.sheetRow;
      }

      psgWriteStaffTab_(staffSh, [item], idx, monthLabel, leaveByCode, alreadyGenerated);
      SpreadsheetApp.flush();

      const L = PSG.STAFF;
      const blockStart = 1 + alreadyGenerated * L.STRIDE;

      const blob = psgExportStaffBlockToPdf_(existingFileId, staffSh, blockStart, L.BLOCK_ROWS, L.IMG_COLS[1]);
      const safeNamePart = psgSanitizeFileNamePart_(`${empCode}_${name}`);
      const pdfName = `${PSG.FILE_PREFIX}_${safeNamePart}_${monthLabel}.pdf`;

      const existingPdf = monthlyFolder.getFilesByName(pdfName);
      while (existingPdf.hasNext()) { existingPdf.next().setTrashed(true); }
      const createdPdfFile = monthlyFolder.createFile(blob.setName(pdfName));
      const pdfFileId = createdPdfFile.getId();

      psgMarkStaffPdfFileId_(emailSh, emailData, sheetRow, pdfFileId);

      alreadyGenerated++;
      generatedCount++;
    }

    const successMsg =
      `Staff payslip PDFs generated for ${monthLabel}.\n\n` +
      `New PDFs created: ${generatedCount}\n` +
      `Folder: ${monthlyFolder.getName()}`;

    return { success: true, message: successMsg };

  } catch (err) {
    return { success: false, message: `Error: ${err && err.message ? err.message : err}` };
  } finally {
    try { lock.releaseLock(); } catch (_) {}
  }
}

/* =========================================================
   WORKER TAB WRITER — LANDSCAPE — UNCHANGED from v8.
========================================================= */

function psgWriteWorkerTab_Landscape_(sheet, items, idx, monthLabel, processedSoFar) {
  const L = PSG.WORKER_LANDSCAPE;
  const startRow = 1 + processedSoFar * L.STRIDE;

  psgEnsureRowCapacity_(sheet, startRow + items.length * L.STRIDE - 1);

  const templateBlock = sheet.getRange(1, 1, L.BLOCK_ROWS, L.IMG_COLS[1]);
  const heightRuns = psgReadRowHeightRuns_(sheet, L.STRIDE);

  for (let i = 0; i < items.length; i++) {
    const blockStart = startRow + i * L.STRIDE;
    if (blockStart === 1) continue;
    const destBlock = sheet.getRange(blockStart, 1, L.BLOCK_ROWS, L.IMG_COLS[1]);
    templateBlock.copyTo(destBlock, SpreadsheetApp.CopyPasteType.PASTE_NORMAL, false);
    psgApplyRowHeightRuns_(sheet, heightRuns, blockStart);
  }

  const bannerText = psgBuildMonthBanner_(sheet, monthLabel);

  const labelSnapshot = psgSnapshotBlock_(sheet, L.BLOCK_ROWS, L.BULK_COLS[0], L.BULK_COLS[1]);
  const wideRowCount = L.PERBLOCK_ROWS[1] - L.PERBLOCK_ROWS[0] + 1;
  const wideSnapshot = psgSnapshotBlock_(sheet, wideRowCount, L.PERBLOCK_COLS[0], L.PERBLOCK_COLS[1], L.PERBLOCK_ROWS[0]);

  const bulkMatrix = [];
  const bulkColCount = L.BULK_COLS[1] - L.BULK_COLS[0] + 1;
  items.forEach((item) => {
    bulkMatrix.push(...psgBuildWorkerBulkBlock_Landscape_(item.row, idx, bannerText, labelSnapshot));
  });
  sheet.getRange(startRow, L.BULK_COLS[0], bulkMatrix.length, bulkColCount).setValues(bulkMatrix);

  items.forEach((item, i) => {
    const blockStart = startRow + i * L.STRIDE;
    const wideRowStart = blockStart + (L.PERBLOCK_ROWS[0] - 1);
    const wideValues = psgBuildWorkerWideBlock_Landscape_(item.row, idx, wideSnapshot);
    sheet.getRange(wideRowStart, L.PERBLOCK_COLS[0], wideRowCount, 2).setValues(wideValues);
  });
}

function psgBuildWorkerBulkBlock_Landscape_(row, idx, bannerText, labelSnapshot) {
  const g = (h) => psgGetCell_(row, idx, h);
  const gn = (h) => psgToNumber_(psgGetCell_(row, idx, h));

  const m = labelSnapshot.map((r) => r.slice());

  m[3][0] = bannerText;

  m[5][1] = g('Employee Code');
  m[5][5] = psgProperCase_(g('Name'));
  m[5][8] = psgProperCase_(g('Designation'));
  m[6][1] = g('UAN No');
  m[6][5] = g('ESI No');
  m[6][8] = g('Date Of Joining');

  const earnRows = [
    ['Basic', 'Earned Basic'], ['DA', 'Earned DA'], ['HRA', 'Earned HRA'],
    ['Conveyance Allowance', 'Earned Conveyance Allowance'],
    ['Special Allowance', 'Earned Special Allowance'],
    ['Petrol Conveyance', 'Earned Petrol Conveyance'],
  ];
  for (let i = 0; i < 6; i++) {
    const rr = 9 + i;
    m[rr][2] = gn(earnRows[i][0]);
    m[rr][3] = gn(earnRows[i][1]);
  }
  m[15][3] = gn('Attendance Bonus');
  m[16][2] = gn('Increment');
  m[17][3] = gn('OT Pay');
  m[18][3] = gn('Carry Forward Pay');

  let actualTotal = 0;
  for (let i = 0; i < 6; i++) actualTotal += gn(earnRows[i][0]);
  m[19][2] = actualTotal;
  m[19][3] = gn('Total Earnings');

  const dedRows = [
    'Employee PF', 'Employee ESI', 'Advance Deduction', 'LWF',
    'Professional Tax', 'TDS', 'Late Deduction', 'Other Deductions',
  ];
  let totalDeductions = 0;
  for (let i = 0; i < 8; i++) {
    const rr = 9 + i;
    const val = gn(dedRows[i]);
    m[rr][8] = val;
    totalDeductions += val;
  }
  m[19][8] = totalDeductions;

  m[12][11] = g('Total Working Days');
  m[14][11] = g('LOP Days');
  m[16][11] = g('Late Penalty');

  return m;
}

function psgBuildWorkerWideBlock_Landscape_(row, idx, wideSnapshot) {
  const g = (h) => psgGetCell_(row, idx, h);
  const gn = (h) => psgToNumber_(psgGetCell_(row, idx, h));

  const m = wideSnapshot.map((r) => r.slice());

  m[0][0] = psgProperCase_(g('Skill Group'));
  m[1][0] = g('Bank Account No');
  m[3][0] = gn('NET');
  m[5][0] = psgFormatPaidOn_(g('Bank Transfer Mark Down'));

  m[7][1]  = g('Total Present Days');
  m[9][1]  = g('Layoff Days');
  m[11][1] = g('OT Hours');

  return m;
}

/* =========================================================
   STAFF TAB WRITER (scratch space for PDF export as of v9)
   UNCHANGED logic — called with single-item arrays now instead
   of a full batch, from generateStaffPayslipPdfsServer_.
========================================================= */

function psgWriteStaffTab_(sheet, items, idx, monthLabel, leaveByCode, processedSoFar) {
  const L = PSG.STAFF;
  const startRow = 1 + processedSoFar * L.STRIDE;

  psgEnsureRowCapacity_(sheet, startRow + items.length * L.STRIDE - 1);

  const templateBlock = sheet.getRange(1, 1, L.BLOCK_ROWS, L.IMG_COLS[1]);
  const heightRuns = psgReadRowHeightRuns_(sheet, L.STRIDE);

  for (let i = 0; i < items.length; i++) {
    const blockStart = startRow + i * L.STRIDE;
    if (blockStart === 1) continue;
    const destBlock = sheet.getRange(blockStart, 1, L.BLOCK_ROWS, L.IMG_COLS[1]);
    templateBlock.copyTo(destBlock, SpreadsheetApp.CopyPasteType.PASTE_NORMAL, false);
    psgApplyRowHeightRuns_(sheet, heightRuns, blockStart);
  }

  const bannerText = psgBuildMonthBanner_(sheet, monthLabel);
  const labelSnapshot = psgSnapshotBlock_(sheet, L.BLOCK_ROWS, L.BULK_COLS[0], L.BULK_COLS[1]);

  const bulkMatrix = [];
  const bulkColCount = L.BULK_COLS[1] - L.BULK_COLS[0] + 1;
  items.forEach((item) => {
    bulkMatrix.push(...psgBuildStaffBulkBlock_(item.row, idx, bannerText, labelSnapshot));
  });
  sheet.getRange(startRow, L.BULK_COLS[0], bulkMatrix.length, bulkColCount).setValues(bulkMatrix);

  items.forEach((item, i) => {
    const blockStart = startRow + i * L.STRIDE;
    const hiRowStart = blockStart + (L.PERBLOCK_ROWS[0] - 1);
    const hiRowCount = L.PERBLOCK_ROWS[1] - L.PERBLOCK_ROWS[0] + 1;
    const hiValues = psgBuildStaffHIColumn_(item.row, idx, leaveByCode, item.empCode);
    sheet.getRange(hiRowStart, L.PERBLOCK_COLS[0], hiRowCount, 2).setValues(hiValues);
  });
}

function psgBuildStaffBulkBlock_(row, idx, bannerText, labelSnapshot) {
  const g = (h) => psgGetCell_(row, idx, h);
  const gn = (h) => psgToNumber_(psgGetCell_(row, idx, h));

  const m = labelSnapshot.map((r) => r.slice());

  m[3][0] = bannerText;

  m[5][1] = g('Employee Code');
  m[6][1] = psgProperCase_(g('Designation'));
  m[7][1] = g('UAN No');
  m[8][1] = g('ESI No');

  const basic = gn('Basic');
  const da = gn('DA');
  const gross = gn('Gross');

  m[10][2] = basic;
  m[10][3] = gn('Earned Basic');
  m[11][2] = da;
  m[11][3] = gn('Earned DA');
  m[12][2] = gn('HRA');
  m[12][3] = gn('Earned HRA');
  m[13][2] = gn('Conveyance Allowance');
  m[13][3] = gn('Earned Conveyance Allowance');
  m[14][2] = gn('Special Allowance');
  m[14][3] = gn('Earned Special Allowance');
  m[15][2] = gn('Petrol Conveyance');
  m[15][3] = gn('Earned Petrol Conveyance');
  m[16][2] = gn('Increment');

  m[18][2] = gross;
  m[18][3] = gn('Earned Total');

  const employerPf = gn('Employer PF');
  const employerEsi = gn('Employer ESI');
  const elCost = Math.round(((basic + da) / 26) * 100) / 100;
  const costToCompany = Math.round((gross + employerPf + employerEsi + elCost) * 100) / 100;

  m[21][2] = employerPf;
  m[22][2] = employerEsi;
  m[23][2] = elCost;
  m[24][2] = costToCompany;

  m[26][6] = gn('NET');

  m[30][0] = g('Total Working Days');
  m[30][1] = g('Total Present Days');
  m[30][2] = g('LOP Days');
  m[30][3] = g('Layoff Days');
  m[30][5] = g('Late Penalty');

  return m;
}

function psgBuildStaffHIColumn_(row, idx, leaveByCode, empCode) {
  const g = (h) => psgGetCell_(row, idx, h);
  const gn = (h) => psgToNumber_(psgGetCell_(row, idx, h));
  const leave = leaveByCode.get(empCode) || { el: '', cl: '', sl: '' };

  const out = [];
  for (let i = 0; i < 22; i++) out.push(['', '']);

  const employeePf = gn('Employee PF');
  const employeeEsi = gn('Employee ESI');
  const tds = gn('TDS');
  const professionalTax = gn('Professional Tax');
  const lwf = gn('LWF');
  const advanceDeduction = gn('Advance Deduction');
  const lateDeduction = gn('Late Deduction');
  const otherDeductions = gn('Other Deductions');

  const totalDeductions = employeePf + employeeEsi + tds + professionalTax
    + lwf + advanceDeduction + lateDeduction + otherDeductions;

  out[0]  = [psgProperCase_(g('Name')), ''];
  out[1]  = [g('Date Of Joining'), ''];
  out[2]  = [g('Bank Account No'), ''];
  out[3]  = [psgFormatPaidOn_(g('Bank Transfer Mark Down')), ''];
  out[5]  = ['', employeePf];
  out[6]  = ['', employeeEsi];
  out[7]  = ['', tds];
  out[8]  = ['', professionalTax];
  out[9]  = ['', lwf];
  out[10] = ['', advanceDeduction];
  out[11] = ['', lateDeduction];
  out[12] = ['', otherDeductions];
  out[13] = ['', totalDeductions];
  out[15] = ['Approved', 'Balance'];
  out[16] = [g('Approved EL Days'), leave.el];
  out[17] = [g('Approved CL Days'), leave.cl];
  out[18] = [g('Approved SL Days'), leave.sl];

  return out;
}

/* =========================================================
   STAFF PDF EXPORT (NEW, v9)
========================================================= */

function psgExportStaffBlockToPdf_(spreadsheetId, sheet, rowStart, rowCount, colCount) {
  const gid = sheet.getSheetId();
  const rowEnd = rowStart + rowCount - 1;
  const P = PSG.STAFF_PDF.PDF;

  const url =
    `https://docs.google.com/spreadsheets/d/${spreadsheetId}/export` +
    `?format=pdf` +
    `&gid=${gid}` +
    `&size=${P.PAPER_SIZE}` +
    `&portrait=${P.PORTRAIT}` +
    `&scale=${P.SCALE_MODE}` +
    `&top_margin=${P.MARGIN_INCHES}` +
    `&bottom_margin=${P.MARGIN_INCHES}` +
    `&left_margin=${P.MARGIN_INCHES}` +
    `&right_margin=${P.MARGIN_INCHES}` +
    `&gridlines=false` +
    `&printtitle=false` +
    `&sheetnames=false` +
    `&pagenum=false` +
    `&horizontal_alignment=CENTER` +
    `&vertical_alignment=TOP` +
    `&r1=${rowStart - 1}&c1=0&r2=${rowEnd}&c2=${colCount}`;

  const response = UrlFetchApp.fetch(url, {
    headers: { Authorization: 'Bearer ' + ScriptApp.getOAuthToken() },
    muteHttpExceptions: true,
  });

  if (response.getResponseCode() !== 200) {
    throw new Error(`PDF export failed for rows ${rowStart}-${rowEnd} (HTTP ${response.getResponseCode()}).`);
  }

  return response.getBlob();
}

/* =========================================================
   STAFF EMAIL MASTER
   v10: psgLoadStaffEmailMaster_ now also returns nextRow / lastCol
   computed once up front, so psgAppendStaffEmailRow_ no longer
   re-queries the sheet for these on every newly auto-added Staff
   employee inside the per-employee loop. Everything else here is
   unchanged from v9.
========================================================= */

function psgLoadStaffEmailMaster_(sh) {
  const lastCol = sh.getLastColumn();
  const headers = sh.getRange(1, 1, 1, lastCol).getDisplayValues()[0];
  const idx = psgBuildHeaderIndex_(headers);

  const H = PSG.STAFF_PDF.HEADERS;
  const cCode = psgRequireHeader_(idx, H.EMP_CODE, PSG.STAFF_PDF.TAB_NAME);
  const cName = psgRequireHeader_(idx, H.NAME, PSG.STAFF_PDF.TAB_NAME);
  const cEmail = psgRequireHeader_(idx, H.EMAIL, PSG.STAFF_PDF.TAB_NAME);
  const cFileId = psgRequireHeader_(idx, H.PDF_FILE_ID, PSG.STAFF_PDF.TAB_NAME);

  const map = new Map();
  const lastRow = sh.getLastRow();

  if (lastRow >= 2) {
    // getDisplayValues() on a HYPERLINK formula cell returns the rendered
    // link text (the file ID itself, per psgMarkStaffPdfFileId_ below) —
    // same convention already used for PAYSLIP_FILE_ID / PAYSLIP_FOLDER_ID
    // in META_DATA.
    const data = sh.getRange(2, 1, lastRow - 1, lastCol).getDisplayValues();
    data.forEach((r, i) => {
      const code = String(r[cCode] || '').trim();
      if (!code) return;
      map.set(code, {
        sheetRow: i + 2,
        name: r[cName] || '',
        email: r[cEmail] || '',
        fileId: String(r[cFileId] || '').trim(),
      });
    });
  }

  // NEW (v10) — computed once here, kept in memory for the rest of the
  // run instead of re-querying sh.getLastRow() / sh.getLastColumn() on
  // every new Staff employee appended during the loop.
  return {
    cCode, cName, cEmail, cFileId, map,
    nextRow: lastRow + 1,
    lastCol: Math.max(lastCol, cCode + 1, cName + 1, cEmail + 1, cFileId + 1),
  };
}

function psgAppendStaffEmailRow_(sh, cols, empCode, name) {
  // v10: uses in-memory cols.nextRow / cols.lastCol (set by
  // psgLoadStaffEmailMaster_ and incremented here) instead of calling
  // sh.getLastRow() / sh.getLastColumn() again for every new employee.
  const newRow = cols.nextRow;
  const rowValues = new Array(cols.lastCol).fill('');
  rowValues[cols.cCode] = empCode;
  rowValues[cols.cName] = name;
  sh.getRange(newRow, 1, 1, cols.lastCol).setValues([rowValues]);
  cols.nextRow++;
  return newRow;
}

// Writes the generated PDF's Drive file ID into the "PDF File ID" column,
// as a clickable HYPERLINK (same convention as psgSetMetaHyperlink_ /
// psgSetMetaFolderHyperlink_) — the cell's presence/absence is the ONLY
// completion marker for Staff PDF generation (no separate timestamp).
function psgMarkStaffPdfFileId_(sh, cols, sheetRow, pdfFileId) {
  const formula = `=HYPERLINK("https://drive.google.com/file/d/${pdfFileId}/view","${pdfFileId}")`;
  sh.getRange(sheetRow, cols.cFileId + 1).setFormula(formula);
}

/* =========================================================
   MONTHLY SUBFOLDER (NEW, v9)
========================================================= */

function psgGetOrCreateMonthlyFolder_(metaSh, monthLabel) {
  let folderId = psgExtractSpreadsheetId_(psgGetMetaValue_(metaSh, PSG.META_KEYS.PAYSLIP_FOLDER_ID));

  if (folderId) {
    try {
      return DriveApp.getFolderById(folderId);
    } catch (_) {
      folderId = '';
    }
  }

  const parent = DriveApp.getFolderById(PSG.FOLDER_ID);
  const existing = parent.getFoldersByName(monthLabel);
  const folder = existing.hasNext() ? existing.next() : parent.createFolder(monthLabel);

  psgSetMetaFolderHyperlink_(metaSh, PSG.META_KEYS.PAYSLIP_FOLDER_ID, folder.getId());

  return folder;
}

function psgEnsureFileInFolder_(file, targetFolder) {
  const targetId = targetFolder.getId();
  const parents = file.getParents();
  while (parents.hasNext()) {
    if (parents.next().getId() === targetId) return;
  }
  file.moveTo(targetFolder);
}

/* =========================================================
   MIGRANT LOOKUP (Employee Master) — UNCHANGED from v8.
========================================================= */

function psgReadMigrantMap_() {
  const ss = SpreadsheetApp.openById(CONST.SOURCES.EMPLOYEE_MASTER_SS_ID);
  const sh = ss.getSheetByName(CONST.TABS.EMPLOYEE_MASTER);
  if (!sh) throw new Error(`Employee Master tab not found: ${CONST.TABS.EMPLOYEE_MASTER}`);

  const lastRow = sh.getLastRow();
  const lastCol = sh.getLastColumn();
  const map = new Map();
  if (lastRow < 2) return map;

  const headers = sh.getRange(1, 1, 1, lastCol).getDisplayValues()[0];
  const idx = psgBuildHeaderIndex_(headers);

  const cId = idx[psgNorm_('ID.NO')];
  const cMigrant = idx[psgNorm_('MIGRANT')];
  if (cId === undefined) throw new Error('Employee Master missing header: ID.NO');
  if (cMigrant === undefined) throw new Error('Employee Master missing header: MIGRANT');

  const data = sh.getRange(2, 1, lastRow - 1, lastCol).getDisplayValues();
  data.forEach((r) => {
    const id = String(r[cId] || '').trim();
    if (!id) return;
    map.set(id, r[cMigrant]);
  });

  return map;
}

