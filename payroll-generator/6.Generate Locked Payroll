/*******************************************************
 * GENERATE LOCKED PAYROLL
 *******************************************************/

const GLP_WEBAPP_URL = 'https://script.google.com/macros/s/AKfycbyhAADy_VUoTuWt8QlLGR5B6I5ckJf67FM456CRxHspRmhluFEZikksIXGRB3pkECK5/exec';
const GLP_OWNER_EMAIL = 'pmo@butlerleather.com';
const GLP_ALLOWED_EMAIL = 'nazneen@butlerleather.com';

function generateLockedPayroll() {
  const ui = SpreadsheetApp.getUi();

  try {
    const currentUser = String(
      (Session.getEffectiveUser() && Session.getEffectiveUser().getEmail()) || ''
    ).trim().toLowerCase();

    // ── Owner: run directly ──
    if (currentUser === GLP_OWNER_EMAIL.toLowerCase()) {
      const result = generateLockedPayrollServer_({
        spreadsheetId: SpreadsheetApp.getActiveSpreadsheet().getId(),
        requestedBy: currentUser,
        runMode: 'direct',
      });
      if (result && result.message) {
        ui.alert('Generate Locked Payroll', result.message, ui.ButtonSet.OK);
      }
      return;
    }

    // ── Allowed user: call Web App (runs as owner) ──
    if (currentUser === GLP_ALLOWED_EMAIL.toLowerCase()) {
      if (!GLP_WEBAPP_URL || GLP_WEBAPP_URL === 'PASTE_YOUR_WEBAPP_URL_HERE') {
        ui.alert(
          'Generate Locked Payroll',
          'Web App URL is not configured. Please deploy the Web App and paste the URL in GLP_WEBAPP_URL.',
          ui.ButtonSet.OK
        );
        return;
      }

      const response = UrlFetchApp.fetch(GLP_WEBAPP_URL, {
        method: 'post',
        contentType: 'application/json',
        payload: JSON.stringify({
          action: 'generateLockedPayroll',
          spreadsheetId: SpreadsheetApp.getActiveSpreadsheet().getId(),
          requestedBy: currentUser,
        }),
        muteHttpExceptions: true,
      });

      const result = JSON.parse(response.getContentText() || '{}');
      if (result.message) {
        ui.alert('Generate Locked Payroll', result.message, ui.ButtonSet.OK);
      }
      return;
    }

    // ── Anyone else: blocked ──
    ui.alert(
      'Generate Locked Payroll',
      'You are not authorized to run this function.',
      ui.ButtonSet.OK
    );

  } catch (err) {
    ui.alert(
      'Generate Locked Payroll',
      `Error: ${err && err.message ? err.message : err}`,
      ui.ButtonSet.OK
    );
  }
}

/* =========================================================
   WEB APP ENTRY POINT
   (Single doPost — routes all actions across all scripts)

   NOTE: the 'exportPayslipPdfs' branch that used to be here has
   been removed — exportPayslipPdfsServer_() no longer exists in
   PAYROLL_GEN_10 (PDF export was dropped entirely per PMO), so
   this branch would have thrown "function not defined" if ever
   called.

   NEW: 'generateStaffPayslipPdfs' branch added below — calls
   generateStaffPayslipPdfsServer_(), which lives in PAYROLL_GEN_10
   (same Apps Script project as this file), same pattern as the
   existing 'generatePayslips' branch. Without this branch, the
   delegate user's Web App call for Staff Payslip PDFs fell through
   to "Unknown action" (owner-direct runs were unaffected, since
   they bypass doPost entirely). Everything else below is unchanged.
========================================================= */

function doPost(e) {
  try {
    const payload = JSON.parse((e.postData && e.postData.contents) || '{}');
    const action  = String(payload.action || '').trim();

    let result;

    if (action === 'generateLockedPayroll') {
      result = generateLockedPayrollServer_(payload);
    } else if (action === 'getPayrollData') {
      result = getPayrollDataServer_(payload);
    } else if (action === 'validateAttendance') {
      result = validateAttendanceServer_(payload);
    } else if (action === 'validatePayroll') {
      result = validatePayrollServer_(payload);
    } else if (action === 'updateSalaryAdvanceRecoveredAmount') {
      result = updateSalaryAdvanceRecoveredAmountServer_(payload);
    } else if (action === 'generateBankTransferFile') {
      result = generateBankTransferFileServer_(payload);
    } else if (action === 'generatePayslips') {
      result = generatePayslipsServer_(payload);
    } else if (action === 'generateStaffPayslipPdfs') {
      result = generateStaffPayslipPdfsServer_(payload);
    } else {
      result = { success: false, message: `Unknown action: "${action}".` };
    }

    return ContentService
      .createTextOutput(JSON.stringify(result))
      .setMimeType(ContentService.MimeType.JSON);

  } catch (err) {
    return ContentService
      .createTextOutput(JSON.stringify({
        success: false,
        message: `Error: ${err && err.message ? err.message : err}`,
      }))
      .setMimeType(ContentService.MimeType.JSON);
  }
}

/* =========================================================
   CORE SERVER FUNCTION (runs as owner always)
========================================================= */

function generateLockedPayrollServer_(payload) {
  const spreadsheetId = String(payload.spreadsheetId || '').trim();
  const userEmail = String(payload.requestedBy || '').trim();
  const runMode = String(payload.runMode || 'webapp').trim();

  const lock = LockService.getScriptLock();
  lock.waitLock(30000);

  let createdLockedFile = null;
  let ss, ui;

  // Hoisted out of the try block so the catch can actually reach them. All three
  // rollback helpers below have existed since this file was written but were never
  // callable from the catch, because the payloads were declared with `const` inside
  // the try and are block-scoped to it.
  let salaryAdvanceSh = null;
  let preparedAttendanceUpdate = null;
  let preparedPayrollControlUpdate = null;
  let preparedMetaUpdate = null;
  let attendanceUpdateApplied = false;
  let payrollControlApplied = false;
  let metaApplied = false;

  try {
    ss = SpreadsheetApp.openById(spreadsheetId);

    // ui is only available in direct (owner) mode
    if (runMode === 'direct') {
      try { ui = SpreadsheetApp.getUi(); } catch (_) { ui = null; }
    }

    const tz = Session.getScriptTimeZone();
    const now = new Date();
    const nowText = Utilities.formatDate(now, tz, 'yyyy-MM-dd HH:mm:ss');

    const fileName = ss.getName();
    const monthInfo = parsePayrollMonthFromName_(fileName);
    if (!monthInfo) {
      return {
        success: false,
        message:
          `Cannot parse payroll month from file name: "${fileName}". ` +
          `Expected like "Payroll-Workings_January_2026".`,
      };
    }

    const monthLabel = monthInfo.monthLabel;
    const lockedFileName = `${CONST.LOCK_RULES.LOCKED_FILE_PREFIX}_${monthLabel}`;

    const meta = ss.getSheetByName(CONST.TABS.META_DATA);
    if (!meta) {
      return { success: false, message: `Missing required tab: ${CONST.TABS.META_DATA}` };
    }

    const lockStatus = String(glpGetMetaValueExactKey_(meta, 'LOCK_STATUS') || '').trim().toUpperCase();
    if (lockStatus === CONST.VALUES.LOCK_STATUS_LOCKED) {
      return { success: false, message: 'Skipped: Payroll is already LOCKED.' };
    }

    const attendanceValidation = String(getMetaValue_(meta, CONST.META_KEYS.ATTENDANCE_VALIDATION) || '').trim().toUpperCase();
    if (!attendanceValidation.includes('VALIDATED')) {
      return { success: false, message: 'Run "Validate Attendance" first.' };
    }

    const storedMonthLabel = String(getMetaValue_(meta, CONST.META_KEYS.PAYROLL_MONTH_LABEL) || '').trim();
    if (!storedMonthLabel || norm_(storedMonthLabel) !== norm_(monthLabel)) {
      return {
        success: false,
        message: `Month mismatch. Re-run "Validate Attendance". (Expected ${monthLabel})`,
      };
    }

    const attendanceLinkOrId = String(getMetaValue_(meta, CONST.META_KEYS.ATTENDANCE_FILE_ID) || '').trim();
    if (!attendanceLinkOrId) {
      return { success: false, message: 'Missing ATTENDANCE_FILE_ID in META_DATA. Re-run "Validate Attendance".' };
    }

    const attendanceFileId = extractSpreadsheetId_(attendanceLinkOrId);
    if (!attendanceFileId) {
      return { success: false, message: 'ATTENDANCE_FILE_ID in META_DATA is not a valid file link/ID.' };
    }

    const existingLockedFileId = String(glpGetMetaValueExactKey_(meta, 'LOCKED_FILE_ID') || '').trim();
    if (existingLockedFileId) {
      return { success: false, message: 'LOCKED_FILE_ID already exists in META_DATA. Duplicate lock blocked.' };
    }

    const payrollSh = ss.getSheetByName(CONST.TEMPLATES.PAYROLL_TAB_NAME);
    if (!payrollSh) {
      return { success: false, message: `Missing required tab: ${CONST.TEMPLATES.PAYROLL_TAB_NAME}` };
    }

    const payrollLastRow = payrollSh.getLastRow();
    const payrollLastCol = payrollSh.getLastColumn();
    if (payrollLastRow < 2 || payrollLastCol < 1) {
      return { success: false, message: `${CONST.TEMPLATES.PAYROLL_TAB_NAME} is empty.` };
    }

    const payrollHeaders = payrollSh.getRange(1, 1, 1, payrollLastCol).getDisplayValues()[0];
    const payrollIdx = buildHeaderIndex_(payrollHeaders);

    glpRequireHeaderIndex_(payrollIdx, CONST.KEYS.PAYROLL, CONST.TEMPLATES.PAYROLL_TAB_NAME);
    glpRequireHeaderIndex_(payrollIdx, 'Advance Deduction', CONST.TEMPLATES.PAYROLL_TAB_NAME);
    const payrollReleaseConfirmationCol = glpRequireHeaderIndex_(payrollIdx, 'Payroll Release Confirmation', CONST.TEMPLATES.PAYROLL_TAB_NAME) + 1;
    const bankTransferMarkDownCol = glpRequireHeaderIndex_(payrollIdx, 'Bank Transfer Mark Down', CONST.TEMPLATES.PAYROLL_TAB_NAME) + 1;

    const attendanceSS = SpreadsheetApp.openById(attendanceFileId);
    const attendanceEntrySh = attendanceSS.getSheetByName(CONST.TABS.ATTENDANCE_ENTRY);
    salaryAdvanceSh = attendanceSS.getSheetByName(CONST.TABS.SALARY_ADVANCE_DEDUCTIONS);

    if (!attendanceEntrySh) {
      return { success: false, message: `Attendance tab not found: ${CONST.TABS.ATTENDANCE_ENTRY}` };
    }
    if (!salaryAdvanceSh) {
      return { success: false, message: `Attendance tab not found: ${CONST.TABS.SALARY_ADVANCE_DEDUCTIONS}` };
    }

    // The Salary Advance Approval tab lives in THIS workings file, not the
    // attendance file. It is the source of truth for Planned EMI and the
    // effective HR Decision from here on — the attendance tab still holds
    // HR's original, untouched figures until the write further down.
    const approvalSh = ss.getSheetByName(CONST.TABS.SALARY_ADVANCE_APPROVAL);
    if (!approvalSh) {
      return { success: false, message: `Tab not found: ${CONST.TABS.SALARY_ADVANCE_APPROVAL}` };
    }

    glpAssertAttendanceEntryLocked_(attendanceEntrySh);
    glpAssertSalaryAdvancePayrollNotLocked_(salaryAdvanceSh);

    try {
      glpAssertSalaryAdvanceApproved_(approvalSh, monthLabel);        // ── NEW ──
      glpAssertRecoveryWithinMaxRecoverable_(approvalSh);             // ── NEW ──
      glpAssertAdvanceDeductionTotalMatchesPlannedEmi_(meta, approvalSh);
      glpAssertHrDecisionConsistentPerEmployee_(approvalSh);          // ── non-negotiable ──
      glpAssertNegativeBalanceEmployeesCleared_(meta);
      glpAssertMetaGrossTotalPayrollMatchesSalaryMaster_(meta);
    } catch (err) {
      return { success: false, message: err.message };
    }

    preparedAttendanceUpdate = glpPrepareSalaryAdvanceUpdatePayload_(payrollSh, salaryAdvanceSh, approvalSh, nowText);
    preparedPayrollControlUpdate = glpPreparePayrollControlCenterUpdatePayload_({
      monthLabel: monthLabel,
      attendanceFileId: attendanceFileId,
      lockedFileName: lockedFileName,
      lockedFileId: null,
      lockedOn: nowText,
      lockedBy: userEmail,
    });
    preparedMetaUpdate = glpPrepareMetaUpdatePayload_(meta);

    const lockedFolder = DriveApp.getFolderById(CONST.FOLDERS.LOCKED_PAYROLL_FILES);

    const existingLocked = lockedFolder.getFilesByName(lockedFileName);
    if (existingLocked.hasNext()) {
      return { success: false, message: `Locked payroll file already exists: ${lockedFileName}` };
    }

    createdLockedFile = DriveApp.getFileById(ss.getId()).makeCopy(lockedFileName, lockedFolder);
    const lockedFileId = createdLockedFile.getId();
    const lockedSS = SpreadsheetApp.openById(lockedFileId);

    glpConvertSpreadsheetToValues_(lockedSS);
    glpSecureLockedPayrollFile_(lockedSS, createdLockedFile);

    const lockedFileUrl = glpBuildSpreadsheetUrl_(lockedFileId);
    const attendanceFileUrl = glpBuildSpreadsheetUrl_(attendanceFileId);

    preparedPayrollControlUpdate.updatesByHeader[CONST.CONTROL_CENTER_HEADERS.LOCKED_ATTENDANCE_FILE_ID] = attendanceFileUrl;
    preparedPayrollControlUpdate.updatesByHeader[CONST.CONTROL_CENTER_HEADERS.LOCKED_PAYROLL_FILE_NAME] = lockedFileName;
    preparedPayrollControlUpdate.updatesByHeader[CONST.CONTROL_CENTER_HEADERS.LOCKED_PAYROLL_FILE_ID] = lockedFileUrl;
    preparedPayrollControlUpdate.updatesByHeader[CONST.CONTROL_CENTER_HEADERS.LOCK_STATUS] = CONST.VALUES.LOCK_STATUS_LOCKED;
    preparedPayrollControlUpdate.updatesByHeader[CONST.CONTROL_CENTER_HEADERS.LOCKED_ON] = nowText;
    preparedPayrollControlUpdate.updatesByHeader[CONST.CONTROL_CENTER_HEADERS.LOCKED_BY] = userEmail;

    preparedMetaUpdate.updatesByKey['LOCK_STATUS'] = CONST.VALUES.LOCK_STATUS_LOCKED;
    preparedMetaUpdate.updatesByKey['LOCKED_FILE_ID'] = lockedFileUrl;
    preparedMetaUpdate.updatesByKey['LOCKED_ON'] = nowText;
    preparedMetaUpdate.updatesByKey['LOCKED_BY'] = userEmail;

    try {
      glpApplySalaryAdvanceUpdatePayload_(salaryAdvanceSh, preparedAttendanceUpdate);
      attendanceUpdateApplied = true;
      SpreadsheetApp.flush();

      glpPushRecoveredLedgerSnapshot_(attendanceSS, ss);
      glpPushLeaveLedgerSnapshotAndUpdateBalances_(attendanceSS);
      SpreadsheetApp.flush();

    } catch (salaryAdvanceWriteErr) {
      try { glpRollbackSalaryAdvanceUpdatePayload_(salaryAdvanceSh, preparedAttendanceUpdate); } catch (_) {}
      // Cleared so the outer catch does not restore a second time on the way past.
      attendanceUpdateApplied = false;
      SpreadsheetApp.flush();
      throw salaryAdvanceWriteErr;
    }

    // ── WRITE EVERYTHING FIRST, PROTECT AFTERWARDS ──
    //
    // These two writes used to come AFTER the protections below, which made the
    // script block its own META_DATA write — "You are trying to edit a protected
    // cell or object". META_DATA lives in this very workings file, and the
    // protection applied to it leaves a restricted editor list behind, so the
    // write that follows has to happen while the file is still open.
    //
    // Nothing after this point writes to either file, so protecting last is safe.
    glpApplyPayrollControlCenterUpdatePayload_(preparedPayrollControlUpdate);
    payrollControlApplied = true;

    glpApplyMetaUpdatePayload_(preparedMetaUpdate);
    metaApplied = true;

    SpreadsheetApp.flush();

    // ── PROTECTION: Attendance file (whole sheet, fast) ──
    glpProtectEntireSpreadsheet_(attendanceSS, {
      descriptionPrefix: `ATTENDANCE_LOCKED_${monthLabel}`,
      unprotectedRangesBySheetId: {},
      editorsToKeep: [CONST.LOCK_RULES.OWNER_EMAIL],
      preserveExistingEditors: false,
    });

    // ── PROTECTION: Payroll-Workings file
    //    Whole sheet on all tabs EXCEPT PAY_ROLL tab which keeps
    //    Payroll Release Confirmation and Bank Transfer Mark Down columns editable ──
    glpProtectWorkingsFileExceptReleaseAndBankMarkDownColumns_(
      ss,
      payrollSh,
      payrollReleaseConfirmationCol,
      bankTransferMarkDownCol,
      monthLabel
    );

    SpreadsheetApp.flush();

    return {
      success: true,
      message: `Locked payroll created successfully for ${monthLabel}.`,
    };

  } catch (err) {
    // Compensating transaction, unwound in reverse order of application. Each step
    // is guarded on its own so one failing undo cannot swallow the others, and each
    // is gated on an "applied" flag so nothing is restored that was never written.
    //
    // Without this, a failure after the Control Center write left the month stranded:
    // the Control Center row read LOCKED while META_DATA still read OPEN, and the
    // next run failed on a different line for a different reason.
    if (metaApplied && preparedMetaUpdate) {
      try { glpRollbackMetaUpdatePayload_(preparedMetaUpdate); } catch (_) {}
    }
    if (payrollControlApplied && preparedPayrollControlUpdate) {
      try { glpRollbackPayrollControlCenterUpdatePayload_(preparedPayrollControlUpdate); } catch (_) {}
    }
    // The attendance write is step 1, so it unwinds last. Without this the file kept
    // Payroll Status = LOCKED after a failed run, and the next attempt was refused by
    // glpAssertSalaryAdvancePayrollNotLocked_ — "Duplicate payroll lock blocked" —
    // with no way forward except clearing the column by hand.
    if (attendanceUpdateApplied && salaryAdvanceSh && preparedAttendanceUpdate) {
      try { glpRollbackSalaryAdvanceUpdatePayload_(salaryAdvanceSh, preparedAttendanceUpdate); } catch (_) {}
    }
    if (createdLockedFile) {
      try { createdLockedFile.setTrashed(true); } catch (_) {}
    }
    try { SpreadsheetApp.flush(); } catch (_) {}

    return {
      success: false,
      message: `Error: ${err && err.message ? err.message : err}`,
    };
  } finally {
    try { lock.releaseLock(); } catch (_) {}
  }
}

/* =========================================================
   ATTENDANCE PRECHECKS
   — UNCHANGED —
========================================================= */

function glpAssertAttendanceEntryLocked_(attendanceEntrySh) {
  const lastRow = attendanceEntrySh.getLastRow();
  const lastCol = attendanceEntrySh.getLastColumn();

  if (lastRow < 2 || lastCol < 1) {
    throw new Error(`${CONST.TABS.ATTENDANCE_ENTRY} is empty.`);
  }

  const headers = attendanceEntrySh.getRange(1, 1, 1, lastCol).getDisplayValues()[0];
  const idx = buildHeaderIndex_(headers);

  const lockedStatusCol = glpRequireHeaderIndex_(idx, 'LOCKED STATUS', CONST.TABS.ATTENDANCE_ENTRY) + 1;
  const values = attendanceEntrySh.getRange(2, lockedStatusCol, lastRow - 1, 1).getDisplayValues();

  const anyLocked = values.some(r => String(r[0] || '').trim().toUpperCase().includes('LOCKED'));
  if (!anyLocked) {
    throw new Error('Attendance entry is not locked. Lock attendance first, then generate locked payroll.');
  }
}

function glpAssertSalaryAdvancePayrollNotLocked_(salaryAdvanceSh) {
  const lastRow = salaryAdvanceSh.getLastRow();
  const lastCol = salaryAdvanceSh.getLastColumn();

  if (lastRow < 2 || lastCol < 1) return;

  const headers = salaryAdvanceSh.getRange(1, 1, 1, lastCol).getDisplayValues()[0];
  const idx = buildHeaderIndex_(headers);

  const payrollStatusCol = glpRequireHeaderIndex_(idx, 'Payroll Status', CONST.TABS.SALARY_ADVANCE_DEDUCTIONS) + 1;
  const values = salaryAdvanceSh.getRange(2, payrollStatusCol, lastRow - 1, 1).getDisplayValues();

  for (let i = 0; i < values.length; i++) {
    const v = String(values[i][0] || '').trim().toUpperCase();
    if (v.startsWith(CONST.VALUES.LOCK_STATUS_LOCKED)) {
      throw new Error('Salary Advance deductions already has Payroll Status = LOCKED. Duplicate payroll lock blocked.');
    }
  }
}

/* Compares META_DATA's live "Advance Deduction Total"
   ( =IF(B2="","", sum(PAY_ROLL!AR1:AR)) ) against the APPROVAL tab's
   Planned EMI total.

   Repointed from the attendance tab deliberately. "Update Salary Advance
   Recovered Amount" writes PAY_ROLL!Advance Deduction and nothing else, so
   the attendance tab still holds HR's original provisional figures at this
   point and comparing against it would fail every single lock.

   Because META recalculates from the very column the Update button writes,
   this assert doubles as proof that the button ran AND wrote the right
   total — no separate check is needed for that. */
function glpAssertAdvanceDeductionTotalMatchesPlannedEmi_(metaSh, approvalSh) {
  const metaTotal    = glpGetMetaCheckValue_(metaSh, 'Advance Deduction Total', 'Payroll Status');
  const approvalTotal = glpGetSalaryAdvancePlannedEmiTotal_(approvalSh);

  const metaNum     = glpToNumber_(metaTotal);
  const approvalNum = glpToNumber_(approvalTotal);

  if (Math.abs(metaNum - approvalNum) > 0.0001) {
    throw new Error(
      `Advance Deduction Total mismatch. META_DATA = ${metaNum}, ` +
      `${CONST.TABS.SALARY_ADVANCE_APPROVAL} Planned EMI total = ${approvalNum}. ` +
      `Re-run "Update Salary Advance Recovered Amount". Lock process stopped.`
    );
  }
}

/* =========================================================
   NEW PRECHECK: THE APPROVAL MUST HAVE BEEN COMMITTED
   FOR THIS MONTH
   — "Updated On" is stamped only by "Update Salary Advance
   Recovered Amount", and cleared by every Validate Payroll
   refresh. So a present, current-month stamp means the admin's
   figures were committed and nothing has been refreshed since.

   The month is part of the stamp on purpose: the approval tab
   ships inside the payroll workings TEMPLATE, and every month's
   file is a Drive copy of it. A stamp accidentally left in the
   template would otherwise make every future month look
   pre-approved.
========================================================= */

function glpAssertSalaryAdvanceApproved_(approvalSh, monthLabel) {
  const lastRow = approvalSh.getLastRow();
  const lastCol = approvalSh.getLastColumn();
  if (lastRow < 2 || lastCol < 1) return; // no EMI rows this month → nothing to approve

  const headers = approvalSh.getRange(1, 1, 1, lastCol).getDisplayValues()[0];
  const idx = buildHeaderIndex_(headers);

  const empIdx0   = glpRequireHeaderIndex_(idx, 'Employee Code', CONST.TABS.SALARY_ADVANCE_APPROVAL);
  const refIdx0   = glpRequireHeaderIndex_(idx, 'EMI Reference Number', CONST.TABS.SALARY_ADVANCE_APPROVAL);
  const stampIdx0 = glpRequireHeaderIndex_(idx, 'Updated On', CONST.TABS.SALARY_ADVANCE_APPROVAL);

  const values = approvalSh.getRange(2, 1, lastRow - 1, lastCol).getDisplayValues();

  const wantedMonth = String(monthLabel || '').trim().toUpperCase();
  const unstamped = [];
  const wrongMonth = [];
  let emiRows = 0;

  for (let i = 0; i < values.length; i++) {
    const empCode = String(values[i][empIdx0] || '').trim();
    const ref     = String(values[i][refIdx0] || '').trim();
    if (!empCode || !ref) continue;

    emiRows++;
    const stamp = String(values[i][stampIdx0] || '').trim();

    if (!stamp) {
      unstamped.push(`${empCode} · ${ref}`);
      continue;
    }

    const stampMonth = String(stamp.split('|')[0] || '').trim().toUpperCase();
    if (stampMonth !== wantedMonth) {
      wrongMonth.push(`${empCode} · ${ref} → "${stampMonth || '(none)'}"`);
    }
  }

  if (!emiRows) return; // genuinely nothing to approve this month

  if (unstamped.length) {
    throw new Error(
      `Salary advance recovery has not been approved for ${monthLabel}. ` +
      `Run "Update Salary Advance Recovered Amount" before locking. ` +
      `${unstamped.length} unapproved row(s), e.g. ${unstamped.slice(0, 5).join(', ')}.`
    );
  }

  if (wrongMonth.length) {
    throw new Error(
      `Salary advance approval belongs to a different month. Expected "${monthLabel}". ` +
      `Run "Validate Payroll", then "Update Salary Advance Recovered Amount". ` +
      `${wrongMonth.slice(0, 5).join(' | ')}`
    );
  }
}

/* =========================================================
   NEW PRECHECK: RECOVERY MUST FIT WITHIN AVAILABLE PAY
   — The Update button already refuses on an ERROR alert, and
   the entry cell carries data validation. Both are bypassable
   by paste, so this is the authoritative backstop.

   ABSCOND and settlement-month rows are exempt: their amount is
   system-computed and already clamped to Max Recoverable, so
   they can never exceed it by construction.
========================================================= */

function glpAssertRecoveryWithinMaxRecoverable_(approvalSh) {
  const lastRow = approvalSh.getLastRow();
  const lastCol = approvalSh.getLastColumn();
  if (lastRow < 2 || lastCol < 1) return;

  const headers = approvalSh.getRange(1, 1, 1, lastCol).getDisplayValues()[0];
  const idx = buildHeaderIndex_(headers);

  const empIdx0     = glpRequireHeaderIndex_(idx, 'Employee Code', CONST.TABS.SALARY_ADVANCE_APPROVAL);
  const nameIdx0    = glpRequireHeaderIndex_(idx, 'Name', CONST.TABS.SALARY_ADVANCE_APPROVAL);
  const refIdx0     = glpRequireHeaderIndex_(idx, 'EMI Reference Number', CONST.TABS.SALARY_ADVANCE_APPROVAL);
  const plannedIdx0 = glpRequireHeaderIndex_(idx, 'Planned EMI', CONST.TABS.SALARY_ADVANCE_APPROVAL);
  const maxIdx0     = glpRequireHeaderIndex_(idx, 'Max Recoverable', CONST.TABS.SALARY_ADVANCE_APPROVAL);
  const entryIdx0   = glpRequireHeaderIndex_(idx, 'Admin Entry', CONST.TABS.SALARY_ADVANCE_APPROVAL);

  const values = approvalSh.getRange(2, 1, lastRow - 1, lastCol).getValues();

  const byEmp = new Map(); // empCode -> { name, planned, max, hasEntry }

  for (let i = 0; i < values.length; i++) {
    const empCode = String(values[i][empIdx0] || '').trim();
    const ref     = String(values[i][refIdx0] || '').trim();
    if (!empCode || !ref) continue;

    if (!byEmp.has(empCode)) {
      byEmp.set(empCode, {
        name: String(values[i][nameIdx0] || '').trim(),
        planned: 0,
        max: glpToNumber_(values[i][maxIdx0]),
        hasEntry: false,
      });
    }

    const info = byEmp.get(empCode);
    info.planned += glpToNumber_(values[i][plannedIdx0]);

    const entry = values[i][entryIdx0];
    if (entry !== '' && entry != null) info.hasEntry = true;
  }

  const over = [];
  byEmp.forEach((info, empCode) => {
    if (!info.hasEntry) return;                       // system-computed → already clamped
    if (info.planned - info.max > 0.0001) {
      over.push(
        `${info.name} (${empCode}): entered ${info.planned}, ` +
        `available ${info.max}, over by ${info.planned - info.max}`
      );
    }
  });

  if (over.length) {
    throw new Error(
      `Salary advance recovery exceeds available pay for ${over.length} employee(s). ` +
      `Lower the Admin Entry on "${CONST.TABS.SALARY_ADVANCE_APPROVAL}" and re-run ` +
      `"Update Salary Advance Recovered Amount": ${over.join(' | ')}`
    );
  }
}

/* =========================================================
   NEW PRECHECK: NEGATIVE BALANCE EMPLOYEES
========================================================= */

function glpAssertNegativeBalanceEmployeesCleared_(metaSh) {
  const checkLabel = 'Employees with Negative Balance After Advance Deduction';
  const row = glpGetMetaCheckRowByLabel_(metaSh, checkLabel);

  const payrollStatus    = String(row['Payroll Status']      || '').trim();
  const salaryMasterStatus = String(row['Salary Master Status'] || '').trim().toUpperCase();

  // Blank = formula returned "" = no negative balance employees → pass
  if (!payrollStatus) return;

  // Non-blank = one or more employees have negative balance → check HR decision
  if (salaryMasterStatus !== 'PROCEED') {
    throw new Error(
      'Negative net pay detected. Check Attendance and update HR Decision.'
    );
  }
}

/* =========================================================
   NEW PRECHECK: HR DECISION MUST BE CONSISTENT ACROSS AN
   EMPLOYEE'S EMI ROWS (SAME MONTH)
   — Non-negotiable: this function reads no PROCEED/override value
   of any kind (unlike glpAssertNegativeBalanceEmployeesCleared_'s
   "Salary Master Status = PROCEED" override), so there is no way
   for a mismatch to be bypassed.
========================================================= */

function glpAssertHrDecisionConsistentPerEmployee_(approvalSh) {
  const lastRow = approvalSh.getLastRow();
  const lastCol = approvalSh.getLastColumn();
  if (lastRow < 2 || lastCol < 1) return;

  const headers = approvalSh.getRange(1, 1, 1, lastCol).getDisplayValues()[0];
  const idx = buildHeaderIndex_(headers);

  const empIdx0  = glpRequireHeaderIndex_(idx, 'Employee Code', CONST.TABS.SALARY_ADVANCE_APPROVAL);
  const nameIdx0 = glpRequireHeaderIndex_(idx, 'Name', CONST.TABS.SALARY_ADVANCE_APPROVAL);
  const refIdx0  = glpRequireHeaderIndex_(idx, 'EMI Reference Number', CONST.TABS.SALARY_ADVANCE_APPROVAL);
  // Reads the EFFECTIVE decision — HR's fact where there is one, the admin's
  // call otherwise — not HR's raw column, so an approved or refused SKIP is
  // judged on what will actually happen.
  const hrIdx0   = glpRequireHeaderIndex_(idx, 'Effective Decision', CONST.TABS.SALARY_ADVANCE_APPROVAL);

  const values = approvalSh.getRange(2, 1, lastRow - 1, lastCol).getDisplayValues();

  const byEmp = new Map(); // empCode -> { name, rows: [{ ref, decision }] }

  for (let i = 0; i < values.length; i++) {
    const empCode = String(values[i][empIdx0] || '').trim();
    if (!empCode) continue;

    const ref = String(values[i][refIdx0] || '').trim();
    if (!ref) continue;

    // PAY EXTRA / PAY LESS are amount instructions, not decisions about the employee, and
    // Alert requires them on the OLDEST advance only — so they legitimately appear on one
    // row and not the others. Comparing them here would block every multi-advance employee
    // the moment an amount was entered. Departure and SKIP decisions still must agree.
    const raw = String(values[i][hrIdx0] || '').trim().toUpperCase();
    const decision = (raw === 'PAY EXTRA' || raw === 'PAY LESS') ? '' : raw;
    const name = String(values[i][nameIdx0] || '').trim();

    if (!byEmp.has(empCode)) byEmp.set(empCode, { name: name, rows: [] });
    byEmp.get(empCode).rows.push({ ref: ref, decision: decision });
  }

  const mismatches = [];

  byEmp.forEach((info, empCode) => {
    if (info.rows.length < 2) return;

    const firstDecision = info.rows[0].decision;
    const allSame = info.rows.every(r => r.decision === firstDecision);
    if (allSame) return;

    const detail = info.rows
      .map(r => `${r.ref}="${r.decision || '(blank)'}"`)
      .join(', ');

    mismatches.push(`${info.name} (${empCode}): ${detail}`);
  });

  if (mismatches.length) {
    throw new Error(
      `HR Decision mismatch across EMI rows for the same employee. ` +
      `All EMI rows for one employee must carry the same decision this month. ` +
      `Fix in "${CONST.TABS.SALARY_ADVANCE_APPROVAL}" before locking: ${mismatches.join(' | ')}`
    );
  }
}

/* =========================================================
   META CHECK HELPERS
   — UNCHANGED —
========================================================= */

function glpAssertMetaGrossTotalPayrollMatchesSalaryMaster_(metaSh) {
  const grossRow = glpGetMetaCheckRowByLabel_(metaSh, 'Gross Total');

  const payrollStatus = grossRow['Payroll Status'];
  const salaryMasterStatus = grossRow['Salary Master Status'];

  const payrollNum = glpToNumber_(payrollStatus);
  const salaryMasterNum = glpToNumber_(salaryMasterStatus);

  if (Math.abs(payrollNum - salaryMasterNum) > 0.0001) {
    throw new Error(
      `Gross Total mismatch. META_DATA Payroll Status = ${payrollNum}, ` +
      `Salary Master Status = ${salaryMasterNum}. ` +
      `Lock process stopped.`
    );
  }
}

function glpGetMetaCheckValue_(metaSh, checkLabel, targetHeaderName) {
  const rowMap = glpGetMetaCheckRowByLabel_(metaSh, checkLabel);
  const headerName = String(targetHeaderName || 'Payroll Status').trim();

  if (!(headerName in rowMap)) {
    throw new Error(`META_DATA header not found: "${headerName}".`);
  }

  return rowMap[headerName];
}

function glpGetMetaCheckRowByLabel_(metaSh, checkLabel) {
  const lastRow = metaSh.getLastRow();
  const lastCol = metaSh.getLastColumn();
  if (lastRow < 2 || lastCol < 1) {
    throw new Error(`${CONST.TABS.META_DATA} is empty.`);
  }

  const headers = metaSh.getRange(1, 1, 1, lastCol).getDisplayValues()[0];
  const idx = buildHeaderIndex_(headers);

  const checkCol = glpRequireHeaderIndex_(idx, 'Check', CONST.TABS.META_DATA) + 1;
  const data = metaSh.getRange(2, 1, lastRow - 1, lastCol).getDisplayValues();

  for (let i = 0; i < data.length; i++) {
    const label = String(data[i][checkCol - 1] || '').trim();
    if (label === String(checkLabel).trim()) {
      return glpMapMetaRowByHeaders_(headers, data[i]);
    }
  }

  throw new Error(`META_DATA row not found where Check = "${checkLabel}".`);
}

function glpMapMetaRowByHeaders_(headers, rowValues) {
  const out = {};
  for (let i = 0; i < headers.length; i++) {
    const headerText = String(headers[i] || '').trim();
    if (!headerText) continue;
    out[headerText] = rowValues[i];
  }
  return out;
}

/* Now reads the APPROVAL tab, not the attendance deductions tab. */
function glpGetSalaryAdvancePlannedEmiTotal_(approvalSh) {
  const lastRow = approvalSh.getLastRow();
  const lastCol = approvalSh.getLastColumn();
  if (lastRow < 2 || lastCol < 1) return 0;

  const headers = approvalSh.getRange(1, 1, 1, lastCol).getDisplayValues()[0];
  const idx = buildHeaderIndex_(headers);
  const plannedEmiCol = glpRequireHeaderIndex_(idx, 'Planned EMI', CONST.TABS.SALARY_ADVANCE_APPROVAL) + 1;

  const values = approvalSh.getRange(2, plannedEmiCol, lastRow - 1, 1).getDisplayValues();
  let total = 0;

  for (let i = 0; i < values.length; i++) {
    total += glpToNumber_(values[i][0]);
  }

  return total;
}

function glpToNumber_(value) {
  const s = String(value == null ? '' : value)
    .replace(/[₹,\s]/g, '')
    .trim();
  if (!s) return 0;
  const n = Number(s);
  return isNaN(n) ? 0 : n;
}

/* =========================================================
   PREPARE / APPLY ATTENDANCE UPDATE
   — glpPrepareSalaryAdvanceUpdatePayload_ caps Recovered Amount to
   PAY_ROLL's "Advance Recovery Capacity" (2026-07-25); everything
   else in this block (apply/rollback) is unchanged.
========================================================= */

function glpPrepareSalaryAdvanceUpdatePayload_(payrollSh, salaryAdvanceSh, approvalSh, lockedOnText) {
  const payLastRow = payrollSh.getLastRow();
  const payLastCol = payrollSh.getLastColumn();
  const saLastRow = salaryAdvanceSh.getLastRow();
  const saLastCol = salaryAdvanceSh.getLastColumn();

  if (payLastRow < 2) throw new Error(`${CONST.TEMPLATES.PAYROLL_TAB_NAME} has no employee rows.`);
  if (saLastCol < 1) throw new Error(`${CONST.TABS.SALARY_ADVANCE_DEDUCTIONS} is empty.`);

  const payHeaders = payrollSh.getRange(1, 1, 1, payLastCol).getDisplayValues()[0];
  const payIdx = buildHeaderIndex_(payHeaders);

  const saHeaders = salaryAdvanceSh.getRange(1, 1, 1, saLastCol).getDisplayValues()[0];
  const saIdx = buildHeaderIndex_(saHeaders);

  const payEmpIdx0 = glpRequireHeaderIndex_(payIdx, CONST.KEYS.PAYROLL, CONST.TEMPLATES.PAYROLL_TAB_NAME);
  const payAdvIdx0 = glpRequireHeaderIndex_(payIdx, 'Advance Deduction', CONST.TEMPLATES.PAYROLL_TAB_NAME);
  const payCapacityIdx0 = glpRequireHeaderIndex_(payIdx, 'Advance Recovery Capacity', CONST.TEMPLATES.PAYROLL_TAB_NAME);

  const saEmpIdx0 = glpRequireHeaderIndex_(saIdx, CONST.KEYS.ATTENDANCE_TABS[CONST.TABS.SALARY_ADVANCE_DEDUCTIONS], CONST.TABS.SALARY_ADVANCE_DEDUCTIONS);
  const saRefIdx0 = glpRequireHeaderIndex_(saIdx, 'EMI Reference Number', CONST.TABS.SALARY_ADVANCE_DEDUCTIONS);
  const saRecoveredIdx0 = glpRequireHeaderIndex_(saIdx, 'Recovered Amount', CONST.TABS.SALARY_ADVANCE_DEDUCTIONS);
  const saPayrollStatusIdx0 = glpRequireHeaderIndex_(saIdx, 'Payroll Status', CONST.TABS.SALARY_ADVANCE_DEDUCTIONS);
  const saPlannedEmiIdx0 = glpRequireHeaderIndex_(saIdx, 'Planned EMI', CONST.TABS.SALARY_ADVANCE_DEDUCTIONS);
  const saHrDecisionIdx0 = glpRequireHeaderIndex_(saIdx, 'HR Decision', CONST.TABS.SALARY_ADVANCE_DEDUCTIONS);

  const payrollData = payrollSh.getRange(2, 1, payLastRow - 1, payLastCol).getDisplayValues();
  const salaryAdvanceData = saLastRow >= 2
    ? salaryAdvanceSh.getRange(2, 1, saLastRow - 1, saLastCol).getDisplayValues()
    : [];

  const hasAnySalaryAdvanceEmployeeCode = salaryAdvanceData.some(row =>
    String(row[saEmpIdx0] || '').trim()
  );

  if (!hasAnySalaryAdvanceEmployeeCode) {
    return {
      noEmployeeCodeMode: true,
      lockMarkerCellA1: 'J2',
      lockMarkerValue: `${CONST.VALUES.LOCK_STATUS_LOCKED} | ${lockedOnText || ''}`.trim(),
      originalLockMarkerValue: salaryAdvanceSh.getRange('J2').getValue(),
      rowCount: 1,
    };
  }

  // ---- Approved figures, keyed employee||ref ----
  // Planned EMI and the effective decision come from the APPROVAL tab, which is
  // the source of truth from the moment "Update Salary Advance Recovered Amount"
  // runs. The attendance tab still holds HR's original provisional values and is
  // only written at the very end of this lock.
  const approved = glpBuildApprovedByRef_(approvalSh);

  // Capacity remains a no-op backstop: the approved amount is already clamped to
  // Max Recoverable upstream, so Advance Deduction never exceeds it. Kept because
  // it costs nothing and catches any path we did not foresee.
  const empCapacityByCode = new Map();
  for (let i = 0; i < payrollData.length; i++) {
    const empCode = String(payrollData[i][payEmpIdx0] || '').trim();
    if (!empCode) continue;
    empCapacityByCode.set(empCode, glpToNumber_(payrollData[i][payCapacityIdx0]));
  }

  // ---- Draw capacity down OLDEST ADVANCE FIRST ----
  // Previously this consumed capacity in physical sheet row order, so which loan
  // absorbed a shortfall depended on where its row happened to sit. EMI reference
  // numbers are issued as max+1, so a lower number is always the older advance.
  // The sort must be NUMERIC on the captured digits — lexically "EMI-10" sorts
  // before "EMI-2", which would recover the wrong loan first. Rows whose ref does
  // not match the pattern sort last, preserving their relative order.
  const order = salaryAdvanceData.map((row, i) => ({
    i,
    emp: String(row[saEmpIdx0] || '').trim(),
    refNum: glpRefNumber_(row[saRefIdx0]),
  }));
  order.sort((a, b) => (a.refNum - b.refNum) || (a.i - b.i));

  const recoveredValues             = new Array(salaryAdvanceData.length);
  const payrollStatusValues         = new Array(salaryAdvanceData.length);
  const plannedEmiValues            = new Array(salaryAdvanceData.length);
  const hrDecisionValues            = new Array(salaryAdvanceData.length);
  const originalRecoveredValues     = [];
  const originalPayrollStatusValues = [];
  const originalPlannedEmiValues    = [];
  const originalHrDecisionValues    = [];

  for (let i = 0; i < salaryAdvanceData.length; i++) {
    originalRecoveredValues.push([salaryAdvanceData[i][saRecoveredIdx0]]);
    originalPayrollStatusValues.push([salaryAdvanceData[i][saPayrollStatusIdx0]]);
    originalPlannedEmiValues.push([salaryAdvanceData[i][saPlannedEmiIdx0]]);
    originalHrDecisionValues.push([salaryAdvanceData[i][saHrDecisionIdx0]]);
  }

  for (let k = 0; k < order.length; k++) {
    const i = order[k].i;
    const empCode = order[k].emp;

    if (!empCode) {
      recoveredValues[i]     = [''];
      payrollStatusValues[i] = [''];
      plannedEmiValues[i]    = [salaryAdvanceData[i][saPlannedEmiIdx0]];
      hrDecisionValues[i]    = [salaryAdvanceData[i][saHrDecisionIdx0]];
      continue;
    }

    const ref = String(salaryAdvanceData[i][saRefIdx0] || '').trim();
    const app = approved[empCode.toUpperCase() + '||' + ref.toUpperCase()] || null;

    // Approved figures win; fall back to the sheet's own values if a row somehow
    // has no approval counterpart, so a stray row can never blank the record.
    const plannedEmi = app ? app.planned  : glpToNumber_(salaryAdvanceData[i][saPlannedEmiIdx0]);

    // The full Effective Decision is written back, including PAY EXTRA and PAY LESS. That
    // column's dropdown lists only the three HR values, so the write clears the validation
    // first — see glpApplySalaryAdvanceUpdatePayload_.
    const decision   = app ? app.decision : salaryAdvanceData[i][saHrDecisionIdx0];

    plannedEmiValues[i] = [plannedEmi];
    hrDecisionValues[i] = [decision];

    if (empCapacityByCode.has(empCode)) {
      const remainingCapacity = empCapacityByCode.get(empCode);
      const thisRowRecovered  = Math.min(plannedEmi, remainingCapacity);
      empCapacityByCode.set(empCode, remainingCapacity - thisRowRecovered);
      recoveredValues[i] = [thisRowRecovered];
    } else {
      recoveredValues[i] = [''];
    }

    payrollStatusValues[i] = [CONST.VALUES.LOCK_STATUS_LOCKED];
  }

  return {
    noEmployeeCodeMode: false,
    recoveredColumn: saRecoveredIdx0 + 1,
    payrollStatusColumn: saPayrollStatusIdx0 + 1,
    plannedEmiColumn: saPlannedEmiIdx0 + 1,
    hrDecisionColumn: saHrDecisionIdx0 + 1,
    recoveredValues,
    payrollStatusValues,
    plannedEmiValues,
    hrDecisionValues,
    originalRecoveredValues,
    originalPayrollStatusValues,
    originalPlannedEmiValues,
    originalHrDecisionValues,
    rowCount: salaryAdvanceData.length,
  };
}

/* Approved Planned EMI + effective decision, keyed "EMP||REF". */
function glpBuildApprovedByRef_(approvalSh) {
  const map = {};
  const lastRow = approvalSh.getLastRow();
  const lastCol = approvalSh.getLastColumn();
  if (lastRow < 2 || lastCol < 1) return map;

  const headers = approvalSh.getRange(1, 1, 1, lastCol).getDisplayValues()[0];
  const idx = buildHeaderIndex_(headers);

  const empIdx0     = glpRequireHeaderIndex_(idx, 'Employee Code', CONST.TABS.SALARY_ADVANCE_APPROVAL);
  const refIdx0     = glpRequireHeaderIndex_(idx, 'EMI Reference Number', CONST.TABS.SALARY_ADVANCE_APPROVAL);
  const plannedIdx0 = glpRequireHeaderIndex_(idx, 'Planned EMI', CONST.TABS.SALARY_ADVANCE_APPROVAL);
  const decIdx0     = glpRequireHeaderIndex_(idx, 'Effective Decision', CONST.TABS.SALARY_ADVANCE_APPROVAL);

  const values = approvalSh.getRange(2, 1, lastRow - 1, lastCol).getValues();

  for (let i = 0; i < values.length; i++) {
    const empCode = String(values[i][empIdx0] || '').trim();
    const ref     = String(values[i][refIdx0] || '').trim();
    if (!empCode || !ref) continue;

    map[empCode.toUpperCase() + '||' + ref.toUpperCase()] = {
      planned:  glpToNumber_(values[i][plannedIdx0]),
      decision: String(values[i][decIdx0] || '').trim(),
    };
  }
  return map;
}

/* Numeric part of "EMI-12". Non-matching refs sort last. */
function glpRefNumber_(ref) {
  const m = String(ref == null ? '' : ref).match(/(\d+)/);
  return m ? Number(m[1]) : Number.MAX_SAFE_INTEGER;
}

function glpApplySalaryAdvanceUpdatePayload_(salaryAdvanceSh, payload) {
  if (!payload || !payload.rowCount) return;

  if (payload.noEmployeeCodeMode) {
    salaryAdvanceSh.getRange(payload.lockMarkerCellA1 || 'J2').setValue(payload.lockMarkerValue || CONST.VALUES.LOCK_STATUS_LOCKED);
    return;
  }

  // This is the ONLY write into the attendance file in the whole flow, which is
  // what keeps ATTENDANCE_VALIDATION untouched between Validate Attendance and
  // the lock. Four columns now, not two: the approved Planned EMI and decision
  // are frozen in alongside the recovery result.
  //
  // Planned EMI is written from row 2 down, which replaces that column's
  // ARRAYFORMULA cleanly — row 2 is its anchor. A locked audit artefact holding
  // values rather than a live formula is the better end state.
  salaryAdvanceSh.getRange(2, payload.recoveredColumn, payload.rowCount, 1).setValues(payload.recoveredValues);
  salaryAdvanceSh.getRange(2, payload.payrollStatusColumn, payload.rowCount, 1).setValues(payload.payrollStatusValues);
  salaryAdvanceSh.getRange(2, payload.plannedEmiColumn, payload.rowCount, 1).setValues(payload.plannedEmiValues);

  // HR Decision's dropdown offers only SKIP / RESIGNED / ABSCOND, but the effective decision
  // can also be PAY EXTRA or PAY LESS, which the validation would reject outright. Clear the
  // rule before writing, the same way Sunday "WO" is planted in the Attendance entry tab.
  //
  // Dropping the validation is safe here and only here: this is the last write into the
  // attendance file, and the whole file is protected immediately afterwards. Nobody types in
  // this column again — from this point it is a locked record, not an input.
  const hrDecisionRange = salaryAdvanceSh.getRange(2, payload.hrDecisionColumn, payload.rowCount, 1);
  hrDecisionRange.setDataValidation(null);
  hrDecisionRange.setValues(payload.hrDecisionValues);
}

function glpRollbackSalaryAdvanceUpdatePayload_(salaryAdvanceSh, payload) {
  if (!payload || !payload.rowCount) return;

  if (payload.noEmployeeCodeMode) {
    salaryAdvanceSh.getRange(payload.lockMarkerCellA1 || 'J2').setValue(payload.originalLockMarkerValue || '');
    return;
  }

  // Restores all four columns. Planned EMI comes back as the VALUES it held
  // before the write — the original ARRAYFORMULA is not restored, because the
  // rollback path only fires when a later step threw and the month is going to
  // be re-run from Validate Payroll anyway.
  salaryAdvanceSh.getRange(2, payload.recoveredColumn, payload.rowCount, 1).setValues(payload.originalRecoveredValues);
  salaryAdvanceSh.getRange(2, payload.payrollStatusColumn, payload.rowCount, 1).setValues(payload.originalPayrollStatusValues);
  salaryAdvanceSh.getRange(2, payload.plannedEmiColumn, payload.rowCount, 1).setValues(payload.originalPlannedEmiValues);

  // Validation was cleared on the way in and is not restored — the rollback path only runs
  // when a later step threw, and the month is re-run from Validate Payroll anyway. Clearing
  // it also guarantees the restore itself cannot be rejected.
  const hrDecisionRange = salaryAdvanceSh.getRange(2, payload.hrDecisionColumn, payload.rowCount, 1);
  hrDecisionRange.setDataValidation(null);
  hrDecisionRange.setValues(payload.originalHrDecisionValues);
}

/* =========================================================
   LOCKED COPY CREATION
   — UNCHANGED —
========================================================= */

function glpConvertSpreadsheetToValues_(ss) {
  const sheets = ss.getSheets();

  for (let i = 0; i < sheets.length; i++) {
    const sh = sheets[i];
    const lastRow = sh.getLastRow();
    const lastCol = sh.getLastColumn();
    if (lastRow < 1 || lastCol < 1) continue;

    const rg = sh.getRange(1, 1, lastRow, lastCol);
    rg.copyTo(rg, { contentsOnly: true });
  }

  SpreadsheetApp.flush();
}

function glpSecureLockedPayrollFile_(lockedSS, lockedFile) {
  try {
    if (CONST.LOCK_RULES.OWNER_EMAIL) {
      lockedFile.setOwner(CONST.LOCK_RULES.OWNER_EMAIL);
    }
  } catch (_) {}

  try {
    if (CONST.LOCK_RULES.VIEWER_EMAILS && CONST.LOCK_RULES.VIEWER_EMAILS.length) {
      lockedFile.addViewers(CONST.LOCK_RULES.VIEWER_EMAILS);
    }
  } catch (_) {}

  try {
    const editors = lockedFile.getEditors();
    editors.forEach(ed => {
      const email = ed && ed.getEmail ? ed.getEmail() : '';
      if (email && email !== CONST.LOCK_RULES.OWNER_EMAIL) {
        try { lockedFile.removeEditor(ed); } catch (_) {}
      }
    });
  } catch (_) {}

  glpProtectEntireSpreadsheet_(lockedSS, {
    descriptionPrefix: 'LOCKED_PAYROLL_FILE',
    unprotectedRangesBySheetId: {},
    editorsToKeep: [CONST.LOCK_RULES.OWNER_EMAIL],
    preserveExistingEditors: false,
  });
}

